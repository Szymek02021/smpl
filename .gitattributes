# Wymuszaj czyste zakonczenia linii LF (Linux / Hostido LiteSpeed) dla calego kodu
* text=auto eol=lf

*.php text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sh text eol=lf
.htaccess text eol=lf
.user.ini text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf

# Skrypty Windows zachowuja CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Pliki binarne bez modyfikacji przez Git
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.woff2 binary
*.pdf binary
